pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Environment') {
            steps {
                sh '''
                    echo "Checking build environment..."
                    gcc --version
                    make --version
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    echo "Cleaning old build..."
                    make clean || true

                    echo "Building application..."
                    make
                '''
            }
        }

        stage('Verify Binary') {
            steps {
                sh '''
                    ls -lh PHYSOFTWARE_DCU_GATEWAY
                    file PHYSOFTWARE_DCU_GATEWAY
                '''
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'PHYSOFTWARE_DCU_GATEWAY', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Build completed successfully'
        }

        failure {
            echo 'Build failed'
        }

        always {
            sh 'make clean || true'
        }
    }
}
